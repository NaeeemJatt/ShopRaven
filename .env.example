# ==============================================================================
# ShopRaven Environment Configuration Template (nnstore.shop)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=shopraven-super-secret-key-change-in-production-2026

# Database & Cache
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/shopraven
REDIS_URL=redis://redis:6379/0

# Backend & Orchestrator Services
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ORCHESTRATOR_PORT=4000
PYTHON_BACKEND_URL=http://shopraven-backend:8000
NODE_ORCHESTRATOR_URL=http://shopraven-orchestrator:4000

# Storefront Configuration (WooCommerce REST API v3)
WC_STORE_URL=https://nnstore.shop
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here
WP_APP_USERNAME=admin_nnstore
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Official Store Categories (Strictly Locked)
# 1. Beauty & Care, 2. Kitchen Accessories, 3. Home & Living
# 4. Gym Accessories, 5. Electronic Accessories, 6. Auto & Tools, 7. Accessories
DEFAULT_DELIVERY_FEE_PKR=150
FREE_DELIVERY_THRESHOLD_PKR=2500
PREPAID_DISCOUNT_PERCENT=5

# Profit Corridor & Margin Guard Formulas
PROFIT_MIN_PCT=0.40
PROFIT_MAX_PCT=0.50
COMPETITOR_AVG_SHIPPING_PKR=220

# Dual Dropshipping Suppliers Credentials
HHC_BASE_URL=https://member.hhcdropshipping.com
HHC_EMAIL=your_email@example.com
HHC_PASSWORD=your_hhc_password_here

OSHI_BASE_URL=https://www.portal.oshidropship.com
OSHI_EMAIL=your_email@example.com
OSHI_PASSWORD=your_oshi_password_here

# Google & Gemini AI Engine
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Discord Bot & Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678

# Wasender WhatsApp API Configuration
WASENDER_API_URL=https://wasenderapi.com/api/send-message
WASENDER_API_TOKEN=your_wasender_api_token_here
ADMIN_WHATSAPP_NUMBER=+923114618934
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
STORE_SUPPORT_WHATSAPP=+923114618934
